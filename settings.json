{
    "files.associations": {
        "*.cpp": "c++",
        "*.h": "c++",
        "*.hpp": "c++",
        "*.csv": "text",
        "*.json": "json"
    },
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnPaste": true,
    "editor.formatOnType": true,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.wordWrap": "on",
    "editor.wrappingIndent": "indent",
    "editor.minimap.enabled": true,
    "editor.scrollBeyondLastLine": false,
    "search.exclude": {
        "**/.git": true,
        "**/*.log": true,
        "**/*.o": true,
        "**/*.obj": true,
        "**/*.exe": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/*.log": true,
        "**/*.o": true,
        "**/*.obj": true,
        "**/*.exe": true,
        "**/.vscode": true
    },
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureArgs": "",
    "cmake.cCompilerPath": "/usr/bin/gcc",
    "cmake.cppCompilerPath": "/usr/bin/g++",
    "cmake.generator": "Unix Makefiles",
    "cmake.useCMakeEnvVar": true,
    "cmake.buildArgs": "-j$(nproc)",
    "cmake.environmentVariables": {
        "LANG": "en_US.UTF-8",
        "LC_ALL": "en_US.UTF-8"
    },
    "clangd.path": "/usr/bin/clangd",
    "clangd.formatOnType": true,
    "C_Cpp.intelliSenseEngine": "Enabled",
    "C_Cpp.errors.suppressSemicolonInDeclarations": true,
    "C_Cpp.errors.enableHttpSupport": true,
    "cmake.sourceDirectory": "D:/CS/projects/rumorguard/members/m4_setup/root"
}